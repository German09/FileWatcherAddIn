// Пример FileWatcher 1.1 — несколько папок, русские имена методов.

&НаКлиенте
Перем КомпонентаФайлов;

&НаКлиенте
Процедура ПодключитьКомпонентуФайлов(Команда)

	ПутьККомпоненте = "ОбщийМакет.FileWatcher";

	// Установка нужна при первом использовании на клиенте (обязательна в веб-клиенте,
	// в тонком/толстом — безвредна и помогает при подключении из макета).
	УстановитьВнешнююКомпоненту(ПутьККомпоненте);

	Если Не ПодключитьВнешнююКомпоненту(ПутьККомпоненте, "FW",
			ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.НеИзолированно) Тогда
		ПоказатьПредупреждение(, "Не удалось подключить FileWatcher");
		Возврат;
	КонецЕсли;

	КомпонентаФайлов = Новый("AddIn.FW.FileWatcher");

	Каталог1 = "C:\Inbox";
	Каталог2 = "C:\Outbox";

	Если Не КомпонентаФайлов.НачатьСлежение(Каталог1, Истина, 1048576) Тогда
		ПоказатьПредупреждение(, "Ошибка: " + КомпонентаФайлов.ПолучитьПоследнююОшибку(Каталог1));
		Возврат;
	КонецЕсли;

	Если Не КомпонентаФайлов.НачатьСлежение(Каталог2, Ложь) Тогда
		ПоказатьПредупреждение(, "Ошибка: " + КомпонентаФайлов.ПолучитьПоследнююОшибку(Каталог2));
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСлежение(Команда)

	Если КомпонентаФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КомпонентаФайлов.ОстановитьВсе();

КонецПроцедуры

// Обработчик внешнего события компоненты FileWatcher.
//
// Параметры:
//  Источник - Строка - всегда "FileWatcher";
//  Событие  - Строка - путь папки слежения (как передано в НачатьСлежение / StartWatch);
//  Данные   - Строка - JSON-объект UTF-8 с полями события файла. После ПрочитатьJSON доступны:
//
//    type             - Строка  - тип операции:
//                                 "created"  — создание;
//                                 "deleted"  — удаление;
//                                 "modified" — изменение;
//                                 "renamed"  — переименование;
//    itemType         - Строка  - тип объекта: "file" или "directory";
//    path             - Строка  - полный путь к объекту (для renamed совпадает с newPath);
//    oldPath          - Строка  - прежний путь (заполняется только для renamed, иначе "");
//    newPath          - Строка  - новый путь (заполняется только для renamed, иначе "");
//    date             - Строка  - дата/время в формате "yyyy-MM-ddTHH:mm:ss"
//                                 (mtime файла, если доступен; для deleted — время события);
//    content          - Строка  - текстовое содержимое файла (UTF-8);
//                                 для directory, deleted, бинарных и при ошибке чтения — "";
//    contentTruncated - Булево  - Истина, если файл больше лимита МаксБайтСодержимого;
//    contentSkipped   - Булево  - Истина, если содержимое не читалось
//                                 (бинарный файл, ошибка доступа, нулевой лимит и т.п.).
//
&НаКлиенте
Процедура ОбработкаВнешнегоСобытия(Источник, Событие, Данные)

	Если Источник <> "FileWatcher" Тогда
		Возврат;
	КонецЕсли;

	ПапкаСлежения = Событие; // путь, переданный в НачатьСлежение

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Данные);
	Поля = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Текст = СтрШаблон("%1 [%2] %3 %4",
		ПапкаСлежения,
		Поля.type,
		Поля.itemType,
		Поля.path);

	Если Поля.type = "renamed" Тогда
		Текст = Текст + СтрШаблон("; %1 -> %2", Поля.oldPath, Поля.newPath);
	КонецЕсли;

	Сообщить(Текст);

КонецПроцедуры
